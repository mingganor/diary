{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang 编译 C 文件",
            "command": "/usr/bin/clang -fcolor-diagnostics -fansi-escape-codes -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && rm -rf \"${fileDirname}/${fileBasenameNoExtension}.dSYM\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译 C (.c) 文件（不留 .o 和 .dSYM）"
        },
        {
            "type": "shell",
            "label": "C/C++: clang++ 编译 C++ 文件",
            "command": "/usr/bin/clang++ -fcolor-diagnostics -fansi-escape-codes -std=c++17 -stdlib=libc++ -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && rm -rf \"${fileDirname}/${fileBasenameNoExtension}.dSYM\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "编译 C++ (.cpp) 文件（不留 .o 和 .dSYM）"
        },
        {
            "type": "shell",
            "label": "Python: 运行当前文件",
            "command": "python3",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "运行 Python (.py) 文件"
        }
    ]
}